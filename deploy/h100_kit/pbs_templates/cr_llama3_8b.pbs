#!/bin/bash
#PBS -N lomap_cr_llama3_8b
#PBS -l select=1:ncpus=16:ngpus=8:mem=200gb
#PBS -l walltime=18:00:00
#PBS -j oe
#PBS -o logs/cr_llama3_8b.log
set -e
REPO_ROOT=${REPO_ROOT:-$PBS_O_WORKDIR}
cd "$REPO_ROOT"
source .venv/bin/activate
export PYTHONPATH="$REPO_ROOT/CR_MR/peft/src:$PYTHONPATH"
export TOKENIZERS_PARALLELISM=false
mkdir -p logs

# LLaMA3-8B: r ∈ {16,32}
bash deploy/h100_kit/scripts/run_cr_grid.sh llama3-8b 16,32 lomap,lora,dora 0,1,2,3,4,5,6,7
